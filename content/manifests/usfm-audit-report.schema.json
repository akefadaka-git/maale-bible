{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maale-bible.example/schemas/usfm-audit-report.schema.json",
  "title": "Maale Bible USFM Audit Report",
  "description": "Machine-readable structural audit metadata. Reports must not contain scripture text and never grant content-intake or publication permission.",
  "type": "object",
  "required": [
    "report_version", "source_id", "rights_status", "rights_gate",
    "rights_evidence_fields_present", "content_intake_authorized",
    "structural_audit", "overall_status", "package_inventory",
    "file_results", "issues", "limitations"
  ],
  "properties": {
    "report_version": { "const": "1.2.0" },
    "source_id": { "type": ["string", "null"] },
    "rights_status": { "type": ["string", "null"] },
    "rights_gate": { "enum": ["BLOCKED", "DOCUMENTED_REQUIRES_OWNER_REVIEW"] },
    "rights_evidence_fields_present": { "type": "boolean" },
    "content_intake_authorized": { "const": false },
    "structural_audit": { "enum": ["PASS", "PARTIAL", "FAIL"] },
    "overall_status": {
      "enum": [
        "FAIL",
        "PARTIAL_UNSUPPORTED_FORMAT",
        "STRUCTURE_PASS_RIGHTS_BLOCKED",
        "STRUCTURE_PASS_REQUIRES_OWNER_REVIEW"
      ]
    },
    "package_inventory": {
      "type": "object",
      "required": ["status", "reference", "book_count", "book_ids", "chapter_counts_by_book"],
      "properties": {
        "status": { "enum": ["NOT_PROVIDED", "INVALID", "PASS", "FAIL"] },
        "reference": { "type": ["string", "null"] },
        "book_count": { "type": "integer", "minimum": 0 },
        "book_ids": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9]{3}$" } },
        "chapter_counts_by_book": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "file_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "issues", "errors"],
        "properties": {
          "path": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "manifest_sha256_match": { "type": "boolean" },
          "book_ids": { "type": "array", "items": { "type": "string" } },
          "chapters_by_book": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer" } } },
          "verse_marker_counts_by_book_and_chapter": { "type": "object", "additionalProperties": { "type": "integer" } },
          "line_count": { "type": "integer", "minimum": 0 },
          "ethiopic_codepoint_count": { "type": "integer", "minimum": 0 },
          "unicode_replacement_character_count": { "type": "integer", "minimum": 0 },
          "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
          "errors": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
